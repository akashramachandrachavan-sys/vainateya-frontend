{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vainateya-backend.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://vainateya-backend.onrender.com/storage/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/login",
      "destination": "/auth.html?mode=signin"
    },
    {
      "source": "/signup",
      "destination": "/auth.html?mode=signup"
    },
    {
      "source": "/((?!dashboard|auth|login|signup).*)",
      "destination": "/index.html"
    }
  ]
}